# Optional real retrieval
SEARXNG_BASE_URL=http://localhost:8080
# Docker defaults to the bundled SearXNG service. Alternatives: deterministic, serpapi.
CLAIM_POLYGRAPH_SEARCH_PROVIDER=serpapi
SEARXNG_ENGINES=duckduckgo,bing,mojeek

# Optional hosted search (explicit opt-in; do not commit the real key)
# SERPAPI_API_KEY=your-serpapi-api-key
# SERPAPI_ENGINE=google
# SERPAPI_LANGUAGE=en
# SERPAPI_COUNTRY=us
# SERPAPI_TIMEOUT_SECONDS=15

# Optional specialist research adapters (explicit opt-in)
# NCBI_EMAIL=developer@example.org
# NCBI_API_KEY=your-ncbi-api-key
# SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
# GOOGLE_FACT_CHECK_API_KEY=your-google-fact-check-api-key

# Optional local structured reasoning
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=your-installed-model
OLLAMA_TIMEOUT_SECONDS=120

# Optional hosted structured reasoning (paid, explicit opt-in)
# Keep the real key only in .env, which is ignored by Git.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
CLAIM_POLYGRAPH_MODEL_PROVIDER=openai
# Default durable orchestration; set to direct for rollback or
# multi_agent_experimental for the bounded research experiment.
CLAIM_POLYGRAPH_ORCHESTRATOR=langgraph
