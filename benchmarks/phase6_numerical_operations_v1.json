  "cases": [
    {"case_id":"NUM-001","description":"One kilometre equals 1,000 metres.","operation":"direct","expected_values":[{"value":"1","unit":"kilometre","dimension":"distance"}],"operands":[{"value":"1000","unit":"metre","dimension":"distance"}],"expected_state":"verified","expected_result":"1"},
    {"case_id":"NUM-002","description":"One hundred Celsius equals 373.15 kelvin.","operation":"direct","expected_values":[{"value":"373.15","unit":"kelvin","dimension":"temperature"}],"operands":[{"value":"100","unit":"celsius","dimension":"temperature"}],"expected_state":"verified","expected_result":"373.15"},
    {"case_id":"NUM-003","description":"One atmosphere is between 101 and 102 kilopascals.","operation":"direct","comparator":"between_inclusive","expected_values":[{"value":"101","unit":"kilopascal","dimension":"pressure"},{"value":"102","unit":"kilopascal","dimension":"pressure"}],"operands":[{"value":"1","unit":"atmosphere","dimension":"pressure"}],"expected_state":"verified","expected_result":"101.325"},
    {"case_id":"NUM-004","description":"One hour plus 120 minutes equals three hours.","operation":"sum","expected_values":[{"value":"3","unit":"hour","dimension":"duration"}],"operands":[{"value":"1","unit":"hour","dimension":"duration"},{"value":"120","unit":"minute","dimension":"duration"}],"expected_state":"verified","expected_result":"3"},
    {"case_id":"NUM-005","description":"Two kilometres minus 500 metres equals 1,500 metres.","operation":"difference","expected_values":[{"value":"1500","unit":"metre","dimension":"distance"}],"operands":[{"value":"2","unit":"kilometre","dimension":"distance"},{"value":"500","unit":"metre","dimension":"distance"}],"expected_state":"verified","expected_result":"1500"},
    {"case_id":"NUM-006","description":"Two kilometres divided by 500 metres equals four.","operation":"ratio","expected_values":[{"value":"4"}],"operands":[{"value":"2","unit":"kilometre","dimension":"distance"},{"value":"500","unit":"metre","dimension":"distance"}],"expected_state":"verified","expected_result":"4"},
    {"case_id":"NUM-007","description":"An increase from 100 to 110 is ten percent.","operation":"percentage_change","expected_values":[{"value":"10","unit":"percent","dimension":"percentage"}],"operands":[{"value":"100"},{"value":"110"}],"expected_state":"verified","expected_result":"10.0"},
    {"case_id":"NUM-008","description":"An increase from 40 to 45 percent is five percentage points.","operation":"percentage_point_change","expected_values":[{"value":"5","unit":"percentage_point","dimension":"percentage"}],"operands":[{"value":"40","unit":"percent","dimension":"percentage"},{"value":"45","unit":"percent","dimension":"percentage"}],"expected_state":"verified","expected_result":"5"},
    {"case_id":"NUM-009","description":"Eight is second in the complete descending set 10, 8, 6.","operation":"rank","expected_values":[{"value":"2","unit":"rank","dimension":"count"}],"operands":[{"value":"10","unit":"items","dimension":"count"},{"value":"8","unit":"items","dimension":"count"},{"value":"6","unit":"items","dimension":"count"}],"target_operand_index":1,"ranking_complete":true,"expected_state":"verified","expected_result":"2"},
    {"case_id":"NUM-010","description":"One third rounds half-even to 0.33 at two decimal places.","operation":"ratio","expected_values":[{"value":"0.33","tolerance":"0.001"}],"operands":[{"value":"1"},{"value":"3"}],"decimal_places":2,"expected_state":"verified","expected_result":"0.33"},
    {"case_id":"NUM-011","description":"365 does not equal 366.","operation":"direct","expected_values":[{"value":"366","unit":"day","dimension":"duration"}],"operands":[{"value":"365","unit":"day","dimension":"duration"}],"expected_state":"contradicted","expected_result":"365"},
    {"case_id":"NUM-012","description":"Five lies strictly between five and ten is false.","operation":"direct","comparator":"between_exclusive","expected_values":[{"value":"5","unit":"item","dimension":"count"},{"value":"10","unit":"item","dimension":"count"}],"operands":[{"value":"5","unit":"item","dimension":"count"}],"expected_state":"contradicted","expected_result":"5"},
    {"case_id":"NUM-013","description":"A missing operand cannot verify equality.","operation":"direct","expected_values":[{"value":"1"}],"operands":[],"expected_state":"insufficient","expected_result":null},
    {"case_id":"NUM-014","description":"An incomplete comparison set cannot establish rank.","operation":"rank","expected_values":[{"value":"1","unit":"rank","dimension":"count"}],"operands":[{"value":"10","unit":"item","dimension":"count"}],"target_operand_index":0,"ranking_complete":false,"expected_state":"insufficient","expected_result":null},
    {"case_id":"NUM-015","description":"Percentage change from a zero baseline is undefined.","operation":"percentage_change","expected_values":[{"value":"10","unit":"percent","dimension":"percentage"}],"operands":[{"value":"0"},{"value":"1"}],"expected_state":"error","expected_result":null},
    {"case_id":"NUM-016","description":"Currency conversion without a rate is prohibited.","operation":"direct","expected_values":[{"value":"100","unit":"EUR","dimension":"currency"}],"operands":[{"value":"100","unit":"USD","dimension":"currency"}],"expected_state":"error","expected_result":null},
    {"case_id":"NUM-017","description":"Distance cannot be compared with duration.","operation":"direct","expected_values":[{"value":"1","unit":"hour","dimension":"duration"}],"operands":[{"value":"1","unit":"kilometre","dimension":"distance"}],"expected_state":"error","expected_result":null},
