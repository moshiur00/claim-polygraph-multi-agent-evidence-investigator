    {"case_id":"NUM-019","description":"Two kilograms equal 2,000 grams.","operation":"direct","expected_values":[{"value":"2000","unit":"gram","dimension":"mass"}],"operands":[{"value":"2","unit":"kilogram","dimension":"mass"}],"expected_state":"verified","expected_result":"2000"},
    {"case_id":"NUM-020","description":"Nine is greater than eight.","operation":"direct","comparator":"greater_than","expected_values":[{"value":"8","unit":"item","dimension":"count"}],"operands":[{"value":"9","unit":"item","dimension":"count"}],"expected_state":"verified","expected_result":"9"}
  ]
